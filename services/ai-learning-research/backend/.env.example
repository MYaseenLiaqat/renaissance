DATABASE_URL=sqlite:///./research.db
RENAISSANCE_SERVICE_TOKEN=replace-with-a-long-random-secret
# LLM Provider configuration for Controlled AI Tutor
# Supported providers: gemini (default), groq
LLM_PROVIDER=gemini
# Provenance model: gemini-3.5-flash-lite for Gemini (or llama-3.1-8b-instant for Groq)
LLM_MODEL=gemini-3.5-flash-lite
# API key for the chosen LLM provider
LLM_API_KEY=
# Optional: defaults to https://generativelanguage.googleapis.com/v1beta/openai for Gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_TIMEOUT_SECONDS=30
# Pilot values (configurable, not final scientific constants).
AI_INTERACTION_CAP=8
SUPPORTED_PHASE_MINUTES=20
